{
  "name": "nestjs-clinica",
  "version": "1.0.0",
  "description": "NestJS Clinica é um projeto de back-end desenvolvido com o framework [NestJS](https://nestjs.com/).",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "build": "nest build",
    "migration:generate": "npm run build && typeorm migration:generate src/@common/database/migrations/migration -d dist/src/@common/database/cli-typeorm.js && npm run lint",
    "migration:new": "npm run build && typeorm migration:create src/@common/database/migrations/migration",
    "migration:run": "npm run build && typeorm migration:run -d dist/src/@common/database/cli-typeorm.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/src/@common/database/cli-typeorm.js",
    "seed:admin": "ts-node src/@common/database/seeds/create-admin.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.0",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/typeorm": "^12.0.1",
    "argon2": "^0.45.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "26.4.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.2",
    "jiti": "^2.7.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.11"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "allowScripts": {
    "argon2@0.45.1": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf@1.4.0": true
  }
}
